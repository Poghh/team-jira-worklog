/**
 * The "Thay đổi code" tab's diff parser: line numbers on both sides, new /
 * deleted / renamed / binary files, quoted paths.
 *
 * Run: npx tsx tests/code-review-diff.mts
 */
import { type DiffFile, generatedReason, parseDiff } from '@/lib/modules/code-review/diff'
import { highlightDiff, languageOf, splitLines } from '@/lib/modules/code-review/highlight'

let n = 0
let bad = 0
const eq = (got: unknown, want: unknown, m: string) => {
  n++
  if (JSON.stringify(got) !== JSON.stringify(want)) {
    bad++
    console.log('FAIL', m, '\n  got ', JSON.stringify(got), '\n  want', JSON.stringify(want))
  }
}

const text = [
  'diff --git a/Sources/Login.swift b/Sources/Login.swift',
  'index 1111111..2222222 100644',
  '--- a/Sources/Login.swift',
  '+++ b/Sources/Login.swift',
  '@@ -10,4 +10,5 @@ final class Login {',
  '     let a = 1',
  '-    let b = 2',
  '+    let b = 3',
  '+    let c = 4',
  '     }',
  ' ',
  '@@ -40 +41 @@ func x() {',
  '-old',
  '+new',
  '\\ No newline at end of file',
  'diff --git a/New.swift b/New.swift',
  'new file mode 100644',
  'index 0000000..3333333',
  '--- /dev/null',
  '+++ b/New.swift',
  '@@ -0,0 +1,2 @@',
  '+one',
  '+two',
  'diff --git a/Gone.swift b/Gone.swift',
  'deleted file mode 100644',
  '--- a/Gone.swift',
  '+++ /dev/null',
  '@@ -1 +0,0 @@',
  '-bye',
  'diff --git a/Old Name.swift b/New Name.swift',
  'similarity index 90%',
  'rename from Old Name.swift',
  'rename to New Name.swift',
  'diff --git a/logo.png b/logo.png',
  'index 4444444..5555555 100644',
  'Binary files a/logo.png and b/logo.png differ',
  'diff --git "a/T\\303\\252n.swift" "b/T\\303\\252n.swift"',
  '--- "a/T\\303\\252n.swift"',
  '+++ "b/T\\303\\252n.swift"',
  '@@ -1 +1 @@',
  '-a',
  '+b',
  '',
].join('\n')

const files = parseDiff(text)
eq(files.map((f) => [f.path, f.status]), [
  ['Sources/Login.swift', 'modified'],
  ['New.swift', 'added'],
  ['Gone.swift', 'deleted'],
  ['New Name.swift', 'renamed'],
  ['logo.png', 'modified'],
  ['Tên.swift', 'modified'],
], 'files and statuses')

const login = files[0]
eq([login.additions, login.deletions], [3, 2], 'counts')
eq(login.hunks.map((h) => h.section), ['final class Login {', 'func x() {'], 'hunk sections')
eq(
  login.hunks[0].lines.map((l) => [l.t, l.o, l.n]),
  [[' ', 10, 10], ['-', 11, null], ['+', null, 11], ['+', null, 12], [' ', 12, 13], [' ', 13, 14]],
  'line numbers on both sides (blank context line kept)',
)
eq(login.hunks[1].lines.map((l) => [l.t, l.o, l.n, l.s]), [['-', 40, null, 'old'], ['+', null, 41, 'new']], 'no-newline marker skipped')
eq(files[1].hunks[0].lines.map((l) => l.n), [1, 2], 'new file from line 1')
eq([files[2].path, files[2].hunks[0].lines[0].o], ['Gone.swift', 1], 'deleted file keeps its path')
eq([files[3].oldPath, files[3].hunks.length], ['Old Name.swift', 0], 'pure rename')
eq(files[4].binary, true, 'binary')

const file = (path: string, first = ''): DiffFile => ({
  path,
  oldPath: path,
  status: 'modified',
  binary: false,
  additions: 1,
  deletions: 0,
  hunks: first ? [{ section: '', oldStart: 1, newStart: 1, lines: [{ t: '+', o: null, n: 1, s: first }] }] : [],
})
eq(
  [
    'matrix-rust-sdk/Cargo.lock',
    'ElementX.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved',
    'ElementX.xcodeproj/project.pbxproj',
    'ElementX/Sources/Generated/Strings.swift',
    'ElementX/Sources/Mocks/Generated/GeneratedMocks.swift',
    'PreviewTests/Sources/GeneratedPreviewTests.swift',
    'UnitTests/__Snapshots__/Login.test.png',
  ].map((p) => generatedReason(file(p))),
  ['lock file', 'lock file', 'file project Xcode', 'code sinh tự động', 'code sinh tự động', 'code sinh tự động', 'snapshot test'],
  'generated by path',
)
eq(generatedReason(file('bindings/x/src/api.rs', '// This file was autogenerated by some hot garbage in the `uniffi` crate.')), 'code sinh tự động', 'generated by header')
eq(
  ['ElementX/Sources/Mocks/ClientProxyMock.swift', 'ElementX/Sources/Screens/Login.swift', 'crates/x/src/lib.rs'].map((p) => generatedReason(file(p, 'import Foundation'))),
  ['', '', ''],
  'hand-written files stay open',
)

/* ── syntax colours ── */
eq(['A.swift', 'lib.rs', 'Podfile', 'Cargo.lock', 'README.txt'].map(languageOf), ['swift', 'rust', 'ruby', 'ini', ''], 'language by file')
eq(splitLines('<span class="a">x\ny</span>z'), ['<span class="a">x</span>', '<span class="a">y</span>z'], 'open span carried over a line break')
{
  const f = parseDiff(
    ['diff --git a/A.swift b/A.swift', '--- a/A.swift', '+++ b/A.swift', '@@ -1,3 +1,4 @@', ' /* start', '-old */', '+new', '+ end */', ' let x = "<b>"', ''].join('\n'),
  )[0]
  const html = highlightDiff(f)!
  eq(html.length, 5, 'one html line per diff line')
  eq([html[1], html[2], html[3]].every((h) => h.includes('hljs-comment')), true, 'block comment coloured on both sides')
  eq(html[4].includes('&lt;b&gt;') && !html[4].includes('<b>'), true, 'code is escaped')
}
eq(highlightDiff(parseDiff(['diff --git a/x.txt b/x.txt', '--- a/x.txt', '+++ b/x.txt', '@@ -1 +1 @@', '-a', '+b', ''].join('\n'))[0]), null, 'unknown language stays plain')

console.log(bad ? `${bad}/${n} failed` : `code-review diff: ${n} ok`)
process.exit(bad ? 1 : 0)
