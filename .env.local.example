# Copy to .env.local and fill in. .env.local is gitignored.
# Tạo token: https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Module "Nhánh & ghi chú": quét nhánh của bạn trên GitHub và gắn vào ticket.
# PAT scope `repo`: https://github.com/settings/tokens
# Để trống nếu không bật module đó.
GITHUB_TOKEN=

# Mặc định cho project này
JIRA_PROJECT_KEY=ABC
JIRA_BOARD_ID=1

# Khi một project chứa nhiều board của nhiều team (board = filter theo label).
# Để trống nếu board chỉ có một team. Settings > "Team trên board" > "Dò từ board"
# tự điền ba giá trị này từ filter của board.
#   LABEL         label mà board lọc theo — mọi task app tạo đều được gắn
#   PREFIX        tiền tố bắt buộc đứng đầu title
#   SPRINT_FILTER chuỗi lọc sprint của team trong danh sách sprint của board
JIRA_TEAM_LABEL=
JIRA_TEAM_PREFIX=
JIRA_TEAM_SPRINT_FILTER=
